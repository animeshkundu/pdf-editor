+
+/* --------------------------------------------------------------------------
+   Spike A: the null filter.
+   
+   Runs pdf_filter_page_contents with a bare sanitize filter and no callbacks,
+   which is specified to change nothing about the page's rendered result. If a
+   filter told to change nothing still perturbs the document, content-stream
+   rewriting cannot be the primary editing path.
+   
+   This is the cheapest question with the largest consequence in the project:
+   it gates sixteen OPEN features including redaction and all in-place editing.
+   -------------------------------------------------------------------------- */
+
+EXPORT
+void wasm_pdf_null_filter_page(pdf_page *page)
+{
+	pdf_filter_options filter_opts = { 0 };
+	pdf_sanitize_filter_options sanitize_opts = { 0 };
+	pdf_filter_factory factories[2] = { { 0 } };
+
+	factories[0].filter = pdf_new_sanitize_filter;
+	factories[0].options = &sanitize_opts;
+	factories[1].filter = NULL;
+	factories[1].options = NULL;
+
+	filter_opts.recurse = 1;      /* descend into Form XObjects */
+	filter_opts.instance_forms = 0;
+	filter_opts.ascii = 0;
+	filter_opts.no_update = 0;
+	filter_opts.newlines = 1;
+	filter_opts.filters = factories;
+
+	TRY({
+		pdf_filter_page_contents(ctx, page->doc, page, &filter_opts);
+	})
+}
