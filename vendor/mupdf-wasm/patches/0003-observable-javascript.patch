+EXPORT
+fz_buffer *wasm_pdf_execute_js(pdf_document *doc, char *name, char *source)
+{
+	fz_buffer *buffer = NULL;
+	char *result = NULL;
+	fz_var(buffer);
+	fz_var(result);
+	fz_try(ctx)
+	{
+		if (!doc->js)
+			fz_throw(ctx, FZ_ERROR_UNSUPPORTED, "PDF JavaScript is not enabled");
+		pdf_js_execute(doc->js, name, source, &result);
+		buffer = fz_new_buffer_from_copied_data(ctx,
+			(const unsigned char *)(result ? result : ""),
+			result ? strlen(result) : 0);
+	}
+	fz_always(ctx)
+		fz_free(ctx, result);
+	fz_catch(ctx)
+		wasm_rethrow(ctx);
+	return buffer;
+}
