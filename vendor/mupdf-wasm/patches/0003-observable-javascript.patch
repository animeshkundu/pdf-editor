+char *
+pdf_load_stream_or_string_as_utf8_limit(fz_context *ctx, pdf_obj *src, size_t max_bytes)
+{
+	if (pdf_is_stream(ctx, src))
+	{
+		fz_stream *stream = NULL;
+		fz_buffer *buffer = NULL;
+		unsigned char chunk[8192];
+		unsigned char *data;
+		size_t length = 0;
+		size_t count;
+		char *result = NULL;
+		fz_var(stream);
+		fz_var(buffer);
+		fz_var(result);
+		fz_try(ctx)
+		{
+			stream = pdf_open_stream(ctx, src);
+			buffer = fz_new_buffer(ctx, sizeof chunk);
+			while ((count = fz_read(ctx, stream, chunk, sizeof chunk)) > 0)
+			{
+				if (count > max_bytes - length)
+					fz_throw(ctx, FZ_ERROR_LIMIT, "decoded PDF string exceeds local limit");
+				fz_append_data(ctx, buffer, chunk, count);
+				length += count;
+			}
+			length = fz_buffer_storage(ctx, buffer, &data);
+			result = pdf_new_utf8_from_pdf_string(ctx, (const char *)data, length);
+		}
+		fz_always(ctx)
+		{
+			fz_drop_stream(ctx, stream);
+			fz_drop_buffer(ctx, buffer);
+		}
+		fz_catch(ctx)
+			fz_rethrow(ctx);
+		return result;
+	}
+	else
+	{
+		const char *data;
+		size_t length;
+		data = pdf_to_string(ctx, src, &length);
+		if (length > max_bytes)
+			fz_throw(ctx, FZ_ERROR_LIMIT, "PDF string exceeds local limit");
+		return pdf_new_utf8_from_pdf_string(ctx, data, length);
+	}
+}
