+EXPORT
+fz_buffer * wasm_pdf_load_stream_max(pdf_obj *obj, size_t max_bytes)
+{
+	fz_stream *stream = NULL;
+	fz_buffer *buffer = NULL;
+	unsigned char chunk[8192];
+	size_t length = 0;
+	size_t count;
+	fz_var(stream);
+	fz_var(buffer);
+	fz_try(ctx)
+	{
+		stream = pdf_open_stream(ctx, obj);
+		buffer = fz_new_buffer(ctx, sizeof chunk);
+		while ((count = fz_read(ctx, stream, chunk, sizeof chunk)) > 0)
+		{
+			if (count > max_bytes - length)
+				fz_throw(ctx, FZ_ERROR_LIMIT, "decoded PDF stream exceeds local review limit");
+			fz_append_data(ctx, buffer, chunk, count);
+			length += count;
+		}
+	}
+	fz_always(ctx)
+		fz_drop_stream(ctx, stream);
+	fz_catch(ctx)
+	{
+		fz_drop_buffer(ctx, buffer);
+		wasm_rethrow(ctx);
+	}
+	return buffer;
+}
