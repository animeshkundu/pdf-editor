{
  "name": "pdf-editor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A private, local-first PDF viewer and editor for the web",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.web.config.ts",
    "preview": "vite preview --config vite.web.config.ts",
    "build": "npm run build:wasm && npm run build:web",
    "build:web": "vite build --config vite.web.config.ts",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build:vercel": "node scripts/check-wasm-fresh.mjs --manifest-only && npm run build:web",
    "typecheck": "tsc --noEmit",
    "lint": "npm run lint:js && npm run lint:rust",
    "lint:js": "eslint .",
    "lint:rust": "node scripts/cargo.mjs clippy --all-targets -- -D warnings",
    "test": "npm run test:js && npm run test:rust",
    "test:js": "vitest run",
    "test:watch": "vitest",
    "test:rust": "node scripts/cargo.mjs test",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "format": "prettier -w .",
    "format:check": "prettier -c .",
    "check": "npm run typecheck && npm run lint && npm run test",
    "check:wasm:fresh": "node scripts/check-wasm-fresh.mjs",
    "check:egress": "node scripts/check-no-egress.mjs",
    "check:size": "node scripts/check-bundle-size.mjs",
    "check:supply": "node scripts/check-supply-chain.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-scroll-area": "1.2.14",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.25.0",
    "mupdf": "1.28.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "3.6.0",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.7.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.5",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
